# Stores-FE environment template.
# In production these are set in the Cloudflare Pages dashboard
# (Settings → Environment Variables) — secrets via `wrangler pages secret put`.

# API base URL. axiosInstance.tsx and lib/searchClient.ts both read this.
NEXT_PUBLIC_API_URL=http://localhost:8000/tradehut/api/v1/

# ISO code catalog prices use until APIs expose per-row currency (must match BE TRADEHUT_STORE_BASE_CURRENCY).
NEXT_PUBLIC_TRADEHUT_STORE_BASE_CURRENCY=GHS

# Public R2 hostname for product imagery (set when USE_R2=True on the BE).
NEXT_PUBLIC_IMAGE_HOST=https://images.tradehut.com

# Social sign-in buttons on /auth/login and /auth/register. A button shows only when its id is
# set here; the same value must be set on Stores-BE (GOOGLE_OAUTH_CLIENT_ID / FACEBOOK_APP_ID).
# These ids are public, not secrets.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Optional: separate auth API host. If unset, lib/authAxiosInstance.tsx falls
# back to ${NEXT_PUBLIC_API_URL}/auth.
# NEXT_PUBLIC_AUTH_API_URL=

# Origin of the Stores-Admin app (seller dashboard). "My store" / "Go to my store"
# links point at ${NEXT_PUBLIC_ADMIN_URL}/seller/overview. If unset, the links are
# hidden on /sell and the nav item falls back to /sell.
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173

# Origin of the Stores-Seller app (Seller Central). Once the nav lock is lifted, "My store" /
# "Go to my store" links should point at ${NEXT_PUBLIC_SELLER_URL}/seller-central instead of
# ${NEXT_PUBLIC_ADMIN_URL}/seller/overview. Unset = links fall back to /sell.
NEXT_PUBLIC_SELLER_URL=http://localhost:3001

# Optional: origin with Cloudflare Image Transformations enabled (e.g. https://tradehut.com). When set, next/image
# requests {base}/cdn-cgi/image/width=W,quality=Q,format=auto/<image-url>. When empty, images load directly from the
# API / R2 / CDN with no transformation (lib/imageLoader.ts). Never routed through /_next/image.
NEXT_PUBLIC_IMAGE_TRANSFORM_BASE=
