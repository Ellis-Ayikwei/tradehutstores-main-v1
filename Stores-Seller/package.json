{
  "name": "tradehut-stores-seller",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:cf": "npm run build && npm run pages:build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "wrangler pages dev .vercel/output/static --compatibility-date=2024-09-23 --compatibility-flag=nodejs_compat",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "deploy:pages": "wrangler pages deploy .vercel/output/static --project-name=tradehut-stores-seller"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.5",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.7",
    "axios": "^1.7.9",
    "formik": "^2.4.9",
    "lucide-react": "^0.460.0",
    "next": "^15.1.2",
    "react": "^18.3.1",
    "react-auth-kit": "^3.1.3",
    "react-dom": "^18.3.1",
    "react-redux": "^8.0.5",
    "swr": "^2.3.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.5",
    "@types/node": "^16.11.64",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.10.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.3",
    "vercel": "^39.0.0",
    "wrangler": "^3.78.0"
  }
}
