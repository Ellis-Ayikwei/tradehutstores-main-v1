{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm install)",
      "Bash(cd Stores-FE && npm run dev)",
      "Bash(cd Stores-FE && npm run build)",
      "Bash(cd Stores-FE && npm run lint)",
      "Bash(cd Stores-Admin && npm run dev)",
      "Bash(cd Stores-Admin && npm run build)",
      "Bash(cd Stores-BE && python manage.py check)",
      "Bash(cd Stores-BE && python manage.py makemigrations:*)",
      "Bash(cd Stores-BE && python manage.py showmigrations:*)",
      "Bash(cd Stores-BE && python manage.py startapp:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git show:*)",
      "Edit(.claude/**)",
      "Edit(Stores-FE/**)",
      "Edit(Stores-Admin/**)",
      "Edit(Stores-BE/**)",
      "Write(.claude/**)",
      "Write(Stores-FE/**)",
      "Write(Stores-Admin/**)",
      "Write(Stores-BE/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(type *.env)",
      "Bash(Get-Content *.env*)",
      "Bash(grep * *.env)",
      "Bash(rg * *.env)"
    ],
    "ask": [
      "Bash(*manage.py migrate*)",
      "Bash(*manage.py test*)",
      "Bash(*manage.py shell*)",
      "Bash(*manage.py shell_plus*)",
      "Bash(*manage.py dbshell*)",
      "Bash(*manage.py runserver*)",
      "Bash(*manage.py loaddata*)",
      "Bash(*manage.py flush*)",
      "Bash(*manage.py sqlflush*)",
      "Bash(*manage.py createsuperuser*)",
      "Bash(*manage.py changepassword*)",
      "Bash(*manage.py seed*)",
      "Bash(*manage.py populate*)",
      "Bash(*manage.py dumpdata*)",
      "Bash(*pytest*)"
    ]
  }
}
